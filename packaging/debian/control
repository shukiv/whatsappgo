# whatsmeow requires Go 1.26. Debian 13 (trixie) ships golang-any 2:1.24, so
# build this package on a host with golang >= 1.26 (for example from
# trixie-backports or unstable); see docs/DEVELOPMENT.md.
Build-Depends: debhelper-compat (= 13), golang-any (>= 2:1.26~), cmake, ninja-build, qt6-base-dev, qt6-declarative-dev, qt6-multimedia-dev, qt6-tools-dev, libkirigami-dev
Standards-Version: 4.7.2
Homepage: https://github.com/shuki/whatsappgo
Rules-Requires-Root: no

Package: whatsappgo
Architecture: any
Depends: ${shlibs:Depends}, ${misc:Depends}, qml6-module-org-kde-kirigami, qml6-module-org-kde-desktop, qml6-module-qtmultimedia
Description: low-memory native WhatsApp client for Linux
 WhatsAppGo uses a Qt/Kirigami desktop interface and an automatically managed
 Go backend bundled with the application.
 It connects through WhatsApp's linked-device protocol without a browser engine.
